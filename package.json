{
  "name": "tclavis",
  "version": "1.0.0",
  "description": "tClavis - MikroTik Hotspot Multi-Router Sync Manager",
  "main": "dist-electron/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build:electron": "node scripts/build-electron.js",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && npm run build:electron && electron-builder",
    "pack:portable": "npm run build:renderer && npm run build:electron && electron-builder --win portable",
    "pack:dir": "npm run build:renderer && npm run build:electron && electron-builder --dir"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
